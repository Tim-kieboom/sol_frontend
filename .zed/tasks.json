// Example:
[
  {
    "label": "Run soul_tester",
    "command": "cargo",
    "args": ["run", "-p", "soul_tester"],
    "cwd": "${ZED_WORKTREE_ROOT}",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "show_summary": true,
    "show_command": true,
    "save": "none"
  },
